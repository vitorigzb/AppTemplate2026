<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.dashboard.DashboardFragment">


    <TextView
        android:id="@+id/text_dashboard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:textAlignment="center"
        android:textSize="20sp"
        android:text="Cadastro de emoções"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textEmoji"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Escolha seu humor:"
        android:textStyle="bold"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/text_dashboard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <LinearLayout
        android:id="@+id/emojiContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/textEmoji"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/emoji_triste"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="😢"
            android:textSize="28sp"
            android:padding="8dp"/>

        <TextView
            android:id="@+id/emoji_neutro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="😐"
            android:textSize="28sp"
            android:padding="8dp"/>

        <TextView
            android:id="@+id/emoji_feliz"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="😊"
            android:textSize="28sp"
            android:padding="8dp"/>

        <TextView
            android:id="@+id/emoji_amor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="😍"
            android:textSize="28sp"
            android:padding="8dp"/>

        <TextView
            android:id="@+id/emoji_raiva"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="😡"
            android:textSize="28sp"
            android:padding="8dp"/>
    </LinearLayout>

    <ImageView
        android:id="@+id/image_item"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="32dp"
        android:contentDescription="Store Photo"
        android:scaleType="centerCrop"
        android:src="@android:drawable/gallery_thumb"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/emojiContainer"/>

    <Button
        android:id="@+id/button_select_image"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Selecionar Imagem"
        android:background="@drawable/edittext_bg"
        android:padding="12dp"
        android:layout_margin="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/image_item" />


    <EditText
        android:id="@+id/descricaoEditText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Como você está se sentindo hoje?"
        android:background="@drawable/edittext_bg"
        android:padding="12dp"
        android:layout_margin="8dp"
        app:layout_constraintTop_toBottomOf="@id/button_select_image"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <EditText
        android:id="@+id/categoriaEditText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Categoria (ex: ansiedade, felicidade)"
        android:background="@drawable/edittext_bg"
        android:padding="12dp"
        android:layout_margin="8dp"
        app:layout_constraintTop_toBottomOf="@id/descricaoEditText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <EditText
        android:id="@+id/intensidadeEditText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Intensidade (0 a 10)"
        android:inputType="number"
        android:background="@drawable/edittext_bg"
        android:padding="12dp"
        android:layout_margin="8dp"
        app:layout_constraintTop_toBottomOf="@id/categoriaEditText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <EditText
        android:id="@+id/dataEditText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Data"
        android:background="@drawable/edittext_bg"
        android:padding="12dp"
        android:layout_margin="8dp"
        app:layout_constraintTop_toBottomOf="@id/intensidadeEditText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>


    <Button
        android:id="@+id/salvarItemButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Salvar"
        android:background="@drawable/card_background"
        android:padding="12dp"
        android:layout_margin="8dp"
        app:layout_constraintTop_toBottomOf="@id/dataEditText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>


</androidx.constraintlayout.widget.ConstraintLayout>